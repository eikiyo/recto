{
  "name": "recto",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "trap 'kill 0' INT TERM; pnpm dev:api & pnpm dev:web & wait",
    "dev:api": "pnpm --filter @recto/api dev",
    "dev:web": "cd apps/web && python3 -m http.server 8765 --directory public",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @recto/api db:generate",
    "db:migrate:local": "pnpm --filter @recto/api db:migrate:local"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@playwright/test": "1.49.0"
  }
}
